# Mumble Server Connection
# ========================
# MUMBLE_HOST: hostname or IP of Mumble server
#   - If Mumble is on the same network: use LAN IP (e.g., 192.168.1.164)
#   - If Mumble is a Docker container on the same network: use container name (e.g., mumble-server)
MUMBLE_HOST=CHANGE_ME
MUMBLE_PORT=64738
MUMBLE_USERNAME=RecorderBot
MUMBLE_PASSWORD=
MUMBLE_CHANNEL=Test
MUMBLE_CONNECT_TIMEOUT_SECONDS=30

# Recorder Settings
# =================
RECORDING_SECONDS=30
RECORDING_MODE=continuous
SEGMENT_DURATION_SECONDS=1800
OUTPUT_DIR=/recordings

# Reconnect Settings
# ==================
RECONNECT_ENABLED=true
RECONNECT_MAX_ATTEMPTS=10
RECONNECT_DELAY_SECONDS=5

# Web UI Settings
# ===============
WEB_PORT=5000
